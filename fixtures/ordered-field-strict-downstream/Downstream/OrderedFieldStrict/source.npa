import Mathlib.Algebra.OrderedField.Strict
import Mathlib.Algebra.Field.Basic

theorem downstream_ordered_field_one_sub_pos_of_lt_one.{u} :
  forall (Scalar : Sort u), forall (zero : Scalar), forall (one : Scalar), forall (add : forall (a : Scalar), forall (b : Scalar), Scalar), forall (neg : forall (a : Scalar), Scalar), forall (sub : forall (a : Scalar), forall (b : Scalar), Scalar), forall (lt_rel : forall (a : Scalar), forall (b : Scalar), Prop), forall (sub_eq_add_neg : forall (a : Scalar), forall (b : Scalar), @Eq.{u} Scalar (sub a b) (add a (neg b))), forall (add_neg_cancel : forall (a : Scalar), @Eq.{u} Scalar (add a (neg a)) zero), forall (add_lt_add_right : forall (a : Scalar), forall (b : Scalar), forall (c : Scalar), forall (hab : lt_rel a b), lt_rel (add a c) (add b c)), forall (x : Scalar), forall (x_lt_one : lt_rel x one), lt_rel zero (sub one x) :=
  fun Scalar => fun zero => fun one => fun add => fun neg => fun sub => fun lt_rel => fun sub_eq_add_neg => fun add_neg_cancel => fun add_lt_add_right => fun x => fun x_lt_one => @ordered_field_one_sub_pos_of_lt_one.{u} Scalar zero one add neg sub lt_rel sub_eq_add_neg add_neg_cancel add_lt_add_right x x_lt_one

theorem downstream_ordered_field_square_lt_one_of_pos_lt_one.{u} :
  forall (Scalar : Sort u), forall (zero : Scalar), forall (one : Scalar), forall (mul : forall (a : Scalar), forall (b : Scalar), Scalar), forall (lt_rel : forall (a : Scalar), forall (b : Scalar), Prop), forall (mul_one : forall (a : Scalar), @Eq.{u} Scalar (mul a one) a), forall (lt_trans : forall (a : Scalar), forall (b : Scalar), forall (c : Scalar), forall (hab : lt_rel a b), forall (hbc : lt_rel b c), lt_rel a c), forall (mul_lt_mul_of_pos_left : forall (a : Scalar), forall (b : Scalar), forall (c : Scalar), forall (hab : lt_rel a b), forall (hc_pos : lt_rel zero c), lt_rel (mul c a) (mul c b)), forall (x : Scalar), forall (x_pos : lt_rel zero x), forall (x_lt_one : lt_rel x one), lt_rel (mul x x) one :=
  fun Scalar => fun zero => fun one => fun mul => fun lt_rel => fun mul_one => fun lt_trans => fun mul_lt_mul_of_pos_left => fun x => fun x_pos => fun x_lt_one => @ordered_field_square_lt_one_of_pos_lt_one.{u} Scalar zero one mul lt_rel mul_one lt_trans mul_lt_mul_of_pos_left x x_pos x_lt_one

theorem downstream_ordered_field_one_sub_square_pos.{u} :
  forall (Scalar : Sort u), forall (zero : Scalar), forall (one : Scalar), forall (add : forall (a : Scalar), forall (b : Scalar), Scalar), forall (neg : forall (a : Scalar), Scalar), forall (sub : forall (a : Scalar), forall (b : Scalar), Scalar), forall (mul : forall (a : Scalar), forall (b : Scalar), Scalar), forall (lt_rel : forall (a : Scalar), forall (b : Scalar), Prop), forall (sub_eq_add_neg : forall (a : Scalar), forall (b : Scalar), @Eq.{u} Scalar (sub a b) (add a (neg b))), forall (add_neg_cancel : forall (a : Scalar), @Eq.{u} Scalar (add a (neg a)) zero), forall (add_lt_add_right : forall (a : Scalar), forall (b : Scalar), forall (c : Scalar), forall (hab : lt_rel a b), lt_rel (add a c) (add b c)), forall (mul_one : forall (a : Scalar), @Eq.{u} Scalar (mul a one) a), forall (lt_trans : forall (a : Scalar), forall (b : Scalar), forall (c : Scalar), forall (hab : lt_rel a b), forall (hbc : lt_rel b c), lt_rel a c), forall (mul_lt_mul_of_pos_left : forall (a : Scalar), forall (b : Scalar), forall (c : Scalar), forall (hab : lt_rel a b), forall (hc_pos : lt_rel zero c), lt_rel (mul c a) (mul c b)), forall (x : Scalar), forall (x_pos : lt_rel zero x), forall (x_lt_one : lt_rel x one), lt_rel zero (sub one (mul x x)) :=
  fun Scalar => fun zero => fun one => fun add => fun neg => fun sub => fun mul => fun lt_rel => fun sub_eq_add_neg => fun add_neg_cancel => fun add_lt_add_right => fun mul_one => fun lt_trans => fun mul_lt_mul_of_pos_left => fun x => fun x_pos => fun x_lt_one => @ordered_field_one_sub_square_pos.{u} Scalar zero one add neg sub mul lt_rel sub_eq_add_neg add_neg_cancel add_lt_add_right mul_one lt_trans mul_lt_mul_of_pos_left x x_pos x_lt_one

theorem downstream_ordered_field_two_ne_zero.{u} :
  forall (Scalar : Sort u), forall (zero : Scalar), forall (one : Scalar), forall (add : forall (a : Scalar), forall (b : Scalar), Scalar), forall (lt_rel : forall (a : Scalar), forall (b : Scalar), Prop), forall (zero_add : forall (a : Scalar), @Eq.{u} Scalar (add zero a) a), forall (add_lt_add_right : forall (a : Scalar), forall (b : Scalar), forall (c : Scalar), forall (hab : lt_rel a b), lt_rel (add a c) (add b c)), forall (lt_trans : forall (a : Scalar), forall (b : Scalar), forall (c : Scalar), forall (hab : lt_rel a b), forall (hbc : lt_rel b c), lt_rel a c), forall (lt_irrefl : forall (a : Scalar), forall (haa : lt_rel a a), forall (P : Prop), P), forall (zero_lt_one : lt_rel zero one), forall (two_eq_zero : @Eq.{u} Scalar (add one one) zero), forall (P : Prop), P :=
  fun Scalar => fun zero => fun one => fun add => fun lt_rel => fun zero_add => fun add_lt_add_right => fun lt_trans => fun lt_irrefl => fun zero_lt_one => fun two_eq_zero => fun P => @ordered_field_two_ne_zero.{u} Scalar zero one add lt_rel zero_add add_lt_add_right lt_trans lt_irrefl zero_lt_one two_eq_zero P

theorem downstream_ordered_field_four_ne_zero.{u} :
  forall (Scalar : Sort u), forall (zero : Scalar), forall (one : Scalar), forall (add : forall (a : Scalar), forall (b : Scalar), Scalar), forall (neg : forall (a : Scalar), Scalar), forall (sub : forall (a : Scalar), forall (b : Scalar), Scalar), forall (mul : forall (a : Scalar), forall (b : Scalar), Scalar), forall (inv : forall (a : Scalar), Scalar), forall (field_args : @FieldLawArgs.{u} Scalar zero one add neg sub mul inv), forall (lt_rel : forall (a : Scalar), forall (b : Scalar), Prop), forall (zero_add : forall (a : Scalar), @Eq.{u} Scalar (add zero a) a), forall (add_lt_add_right : forall (a : Scalar), forall (b : Scalar), forall (c : Scalar), forall (hab : lt_rel a b), lt_rel (add a c) (add b c)), forall (lt_trans : forall (a : Scalar), forall (b : Scalar), forall (c : Scalar), forall (hab : lt_rel a b), forall (hbc : lt_rel b c), lt_rel a c), forall (lt_irrefl : forall (a : Scalar), forall (haa : lt_rel a a), forall (P : Prop), P), forall (zero_lt_one : lt_rel zero one), @Nonzero.{u} Scalar zero (mul (add one one) (add one one)) :=
  fun Scalar => fun zero => fun one => fun add => fun neg => fun sub => fun mul => fun inv => fun field_args => fun lt_rel => fun zero_add => fun add_lt_add_right => fun lt_trans => fun lt_irrefl => fun zero_lt_one => @ordered_field_four_ne_zero.{u} Scalar zero one add neg sub mul inv field_args lt_rel zero_add add_lt_add_right lt_trans lt_irrefl zero_lt_one
